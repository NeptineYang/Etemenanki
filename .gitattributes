# 统一换行符：仓库内文本一律 LF，Windows 专属脚本保留 CRLF。
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 锁文件必须逐字节稳定，避免跨平台 diff 噪声。
Cargo.lock text eol=lf
uv.lock text eol=lf
pnpm-lock.yaml text eol=lf
package-lock.json text eol=lf

# 二进制资源与发布物不参与文本转换。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.jar binary
*.wsl binary
*.exe binary
*.msi binary
*.dll binary
*.so binary
*.dylib binary
*.wasm binary

# UI 参考图使用 Git LFS，避免大二进制直接进入 Git 历史。
vibe_images/*.png filter=lfs diff=lfs merge=lfs -text
